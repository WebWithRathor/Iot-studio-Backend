# ───────────────────────────────────────────────────────────────────────────
# Kokoon IoT Studio — backend configuration
# Copy to .env (or run `npm run setup:env`, which generates random secrets).
# Every value is validated with Zod at startup; the server refuses to start
# with a missing or malformed value and prints which variable is wrong.
# NEVER commit .env. NEVER reuse these development values in production.
# ───────────────────────────────────────────────────────────────────────────

# --- server ---------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=4004
API_BASE_PATH=/api/v1
# Browser origin of the frontend (CORS + CSRF origin check)
FRONTEND_URL=http://localhost:5180
# Extra allowed origins, comma separated (e.g. http://127.0.0.1:5180)
CORS_ORIGINS=http://127.0.0.1:5180
# Number of reverse proxies in front of the API (0 locally). Set it in production
# (e.g. 1 behind nginx / a load balancer): otherwise every request appears to come
# from the proxy's IP and all per-IP rate limits are shared by everyone.
TRUST_PROXY=0

# --- MongoDB (persistent data) ----------------------------------------------
# docker-compose runs a single-node replica set → transactions work locally.
MONGODB_URI=mongodb://127.0.0.1:27017/kokoon?replicaSet=rs0&directConnection=true
# auto | on | off  (on = refuse to start without replica-set transactions)
MONGODB_TRANSACTIONS=auto
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# --- Redis (sessions, rate limits, latest values) ---------------------------
REDIS_URL=redis://:kokoon-dev-redis@127.0.0.1:6379/0
REDIS_KEY_PREFIX=kokoon:

# --- JWT + cookies ---------------------------------------------------------
# 48+ random characters each, DIFFERENT from each other. `npm run setup:env` generates them.
JWT_ACCESS_SECRET=replace-with-48-plus-random-characters-for-access-tokens
JWT_REFRESH_SECRET=replace-with-48-plus-random-characters-for-refresh-tokens
JWT_ISSUER=kokoon-iot-studio
JWT_AUDIENCE=kokoon-iot-studio-web
# Access token 10 minutes, refresh token 7 days (requirements)
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL=7d
# true behind HTTPS (required in production)
COOKIE_SECURE=false
# lax | strict | none (none requires COOKIE_SECURE=true)
COOKIE_SAME_SITE=lax
# Leave empty for host-only cookies
COOKIE_DOMAIN=

# --- encryption at rest (session IP / user agent) ---------------------------
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# --- MQTT ------------------------------------------------------------------
# simulated = in-process broker, demo devices only (no network)
# broker    = connect to a real MQTT broker (docker compose --profile broker up -d)
MQTT_MODE=simulated
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=kokoon-backend
MQTT_PASSWORD=kokoon-dev-mqtt
MQTT_CLIENT_ID=kokoon-backend
# Proposed topic root: {root}/{hardwareId}/telemetry|command|ack/{key}, {root}/{hardwareId}/availability
MQTT_TOPIC_ROOT=kokoon/devices
# Run the server-side demo simulator for devices marked simulated
DEMO_SIMULATION=true
SIM_INTERVAL_MS=2000
# Message/telemetry history retention (TTL index)
MESSAGE_RETENTION_HOURS=24
PERSIST_TELEMETRY=true
# Store at most one telemetry document per topic per interval (the newest value wins);
# 0 = store every message. Live dashboards and latest values always see every message.
TELEMETRY_PERSIST_INTERVAL_MS=5000

# --- Kokoon LMS integration (docs/LMS-INTEGRATION.md) -------------------------
# Off by default. When on, the LMS can sign students in ("Sign in with Kokoon LMS")
# and register the boards they flash (PUT /api/v1/integrations/lms/devices/{hardwareId}).
LMS_INTEGRATION_ENABLED=false
# Origin of the LMS (the SSO form must come from it; https in production)
LMS_URL=http://localhost:3000
# Two DIFFERENT random secrets, ≥48 chars, shared with the LMS backend ONLY
# (openssl rand -base64 48). Never put them in a frontend or in firmware.
LMS_SSO_SECRET=
LMS_API_SECRET=
# Signed LMS API calls per minute, counted after the signature check (one bucket for
# the LMS backend, whatever its IPs). Requests with a bad signature: 600/min per IP.
LMS_API_RATE_LIMIT_PER_MIN=6000
# Broker address handed to devices. NOT 127.0.0.1: a board on your Wi-Fi needs your
# computer's LAN IP, e.g. mqtt://192.168.1.20:1883 (mqtts:// in production).
# For the docker broker also set MQTT_BIND_ADDRESS=0.0.0.0 so it listens on your LAN.
MQTT_PUBLIC_BROKER_URL=mqtt://192.168.1.20:1883
# shared           = every device gets the dev account below (docker compose --profile broker)
# mosquitto-dynsec = one broker account per device (docker compose --profile broker-dynsec;
#                    required in production; needs MQTT_MODE=broker). Device username =
#                    clientId = hardwareId, so hardware ids equal to MQTT_USERNAME,
#                    MQTT_DEVICE_USERNAME or MQTT_CLIENT_ID (or starting with kokoon-backend,
#                    admin, sandbox-, esp32-sim-) are refused.
BROKER_CREDENTIALS_MODE=shared
MQTT_DEVICE_USERNAME=esp32-device
MQTT_DEVICE_PASSWORD=kokoon-dev-device
# Bind address of the docker MQTT broker (127.0.0.1 = this computer only)
MQTT_BIND_ADDRESS=127.0.0.1

# --- accounts --------------------------------------------------------------
# Token build budget per plan. Costs: project 200 (incl. first dashboard),
# extra dashboard 100, widget 100. Deleting refunds. Admins can add bonus tokens.
FREE_PLAN_TOKENS=1000
PLUS_PLAN_TOKENS=10000
PREMIUM_PLAN_TOKENS=50000

# --- payments ---------------------------------------------------------------
# mock = built-in TEST checkout (no money moves; refused in production).
# razorpay = real gateway: set the keys from dashboard.razorpay.com (use rzp_test_… keys first)
# and point a webhook (events: payment.captured, order.paid) at
#   https://<your-api>/api/v1/payments/webhook/razorpay
PAYMENT_PROVIDER=mock
PLUS_PACK_PRICE_INR=999
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
REGISTRATION_ENABLED=true
# Give every new account the sample workspace (development only; must be false in production)
DEMO_WORKSPACE_ON_SIGNUP=true

# --- logging ---------------------------------------------------------------
# error | warn | info | http | debug   (debug shows every database operation)
LOG_LEVEL=debug
# pretty | json (production always uses json)
LOG_FORMAT=pretty
LOG_TO_FILE=true
LOG_DIRECTORY=logs
LOG_DB_OPERATIONS=true

# --- rate limits -------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=600
AUTH_RATE_LIMIT_MAX_REQUESTS=10
COMMAND_RATE_LIMIT_PER_10S=20

# --- development accounts (used only by scripts/seed-dev.ts and create-admin.ts) ---
DEV_USER_EMAIL=student@kokoon.local
DEV_USER_PASSWORD=
DEV_USER_NAME=Demo Student
ADMIN_EMAIL=admin@kokoon.local
ADMIN_PASSWORD=
ADMIN_NAME=Lab Admin
# Plan test accounts (seed:dev): one on the Free plan, one on Premium
TEST_FREE_EMAIL=free.tester@kokoon.local
TEST_FREE_PASSWORD=
TEST_PREMIUM_EMAIL=premium.tester@kokoon.local
TEST_PREMIUM_PASSWORD=
