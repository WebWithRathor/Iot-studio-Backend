# Copy to broker.env (gitignored) on the server. Used only on the broker's first
# start, to create the dynsec admin; must equal MQTT_USERNAME / MQTT_PASSWORD in
# the IoT backend's .env. Changing it later does NOT change the existing account
# (use `docker exec kokoon-iot-broker mosquitto_ctrl ... dynsec setClientPassword`).
MQTT_ADMIN_USERNAME=kokoon-backend
MQTT_ADMIN_PASSWORD=
