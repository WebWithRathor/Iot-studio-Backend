{
  "name": "kokoon-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Kokoon IoT Studio backend — Express + MongoDB + Redis + MQTT",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "setup:env": "tsx scripts/generate-env.ts",
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "test": "npm run test:unit && npm run test:security",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:security": "node --import tsx --test \"tests/security/**/*.test.ts\"",
    "test:integration": "node --import tsx --test --test-concurrency=1 \"tests/integration/**/*.test.ts\"",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "migrate:tokens": "tsx scripts/migrate-token-samples.ts",
    "kit:codes": "tsx scripts/generate-kit-codes.ts",
    "lms:sso": "tsx scripts/lms-dev.ts sso",
    "lms:device": "tsx scripts/lms-dev.ts device",
    "deps:up": "docker compose up -d mongo redis",
    "deps:up:broker": "docker compose --profile broker up -d",
    "deps:up:broker-dynsec": "docker compose --profile broker-dynsec up -d",
    "deps:down": "docker compose down"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "mqtt": "^5.10.3",
    "rate-limit-redis": "^4.2.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
